---
import Lightbox from '@julian_cataldo/astro-lightbox/Lightbox.astro';

// Components
import Header from "../../components/Header/Header.astro"
import Footer from "../../components/Footer/Footer.astro";

// Styles
import '../../styles/reset.css';
import '../../styles/global.css';

// Language
import en from "./en.json"
import fr from "./fr.json"
const language = Astro.currentLocale == "fr" ? fr : en
const htmlLang = Astro.currentLocale == "fr" ? "fr" : "en"

const { pageTitle, menuMode } = Astro.props;
---


<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{language.title} {pageTitle && "-" } {pageTitle}</title>
		<Lightbox />
	</head>
	<body>
        <Header menuMode={menuMode} />
		<div id="main-content">
			<slot />
		</div>
		<Footer />
	</body>
</html>
