---
import fg from 'fast-glob';
import { YouTube } from 'astro-embed';

import en from "./en.json"
import fr from "./fr.json"
const language = Astro.currentLocale == "fr" ? fr : en

const { frontmatter } = Astro.props;
const { slug } = Astro.params;

const matches = fg.sync("public/collaborations/files/" + slug + "/*", { objectMode: true, stats: true });
matches.sort((a, b) => parseFloat(b.stats.mtimeMs) - parseFloat(a.stats.mtimeMs));


---
<style>
    h2 {
        text-align: center;
    }
 
    .collaborations {
        column-count: 1;
        column-gap: 20px;
        margin-top: 20px;
    }

    .collaborations > * {
        margin-bottom: 20px;
        min-width: 100%;
        max-height: 100vh;
        overflow: hidden;
    }

    .collaborations img, .collaborations lite-youtube {
        min-width: 100%;
    }

    .short {
        aspect-ratio: 9 / 16;
    }

    .short lite-youtube {
        min-height: 100%;
    }

    @media screen and (min-width: 768px) {
    .collaborations {
        column-count: 2;
    }

    @media screen and (min-width: 1200px) {
    .collaborations {
        column-count: 3;
    }
}


</style>
<h2>
    {frontmatter.clientName}
</h2>
<div class="text-align-center">
    {frontmatter.clientName == "Dernière Ronde"
        ? <p>{language.derniereronde}</p>
        : <a href={frontmatter.web} target="_blank">{language.amour}</a>
    }

</div>
<div class="collaborations">
    {matches.map((collab) => {return collab.name.includes(".")
            ? <div data-lightbox="true"><img src={collab.path.substring(6)} alt=`Collaboration - ${frontmatter.clientName}` /></div>
            : <div class={collab.name.includes("short") ? "short" : ""}><YouTube id={collab.name.substring(0, collab.name.includes("+") ? collab.name.indexOf("+") : collab.name.length)} posterQuality="max" /></div>}
            )}
</div>