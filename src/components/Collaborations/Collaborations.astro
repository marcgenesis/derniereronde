---
import fg from 'fast-glob';
import { YouTube } from 'astro-embed';

import en from "./en.json"
import fr from "./fr.json"
const language = Astro.currentLocale == "fr" ? fr : en

const { frontmatter } = Astro.props;
const { slug } = Astro.params;

const matches = fg.sync("./src/collaborations/files/" + slug + "/*", { objectMode: true, stats: true });
matches.sort((a, b) => parseFloat(b.stats.mtimeMs) - parseFloat(a.stats.mtimeMs));


---
<style>
    h2 {
        text-align: center;
    }
    
    .collaborations {
        align-items: center;
        margin-top: 20px;
    }

    .collaborations > * {
        flex-grow: 1;
        flex-shrink: 1;
        max-width: 100%;
        max-height: 100vh;
        width: 100%;
    }

    @media screen and (min-width: 1200px) {
    .collaborations > * {
        flex-grow: 1;
        flex-shrink: 1;
        max-width: 100%;
        width: 48%;
    }
}


</style>
<h2>
    {frontmatter.clientName}
</h2>
<div class="text-align-center">
    {frontmatter.clientName == "Dernière Ronde"
        ? <p>{language.derniereronde}</p>
        : <a href={frontmatter.web} target="_blank">{language.amour}</a>
    }

</div>
<div class="collaborations inner-content container-center flex flex-gap-20 flex-wrap flex-center">
    {matches.map((collab) => {return collab.name.includes(".")
            ? <div data-lightbox="true"><img src={collab.path.substring(1)} alt=`Collaboration - ${frontmatter.clientName}` /></div>
            : <YouTube id={collab.name.substring(0, collab.name.indexOf("+"))} posterQuality="max" title={collab.name.substring(collab.name.indexOf("+") + 1)} />}
            )}
</div>