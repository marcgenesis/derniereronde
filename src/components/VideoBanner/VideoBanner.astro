---
import en from "./en.json"
import fr from "./fr.json"
const language = Astro.currentLocale == "fr" ? fr : en

---
<style>
    #video-intro-container {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 100vw;
        height: 100vh;
        overflow: hidden;
    }

    #video-intro {
        position: absolute;
        z-index: -1;
        min-width: 100vw;
        min-height: 100vh;
        max-width: none;
    }

    #above-fold {
        background-color: rgba(0, 0, 0, 0.1);
    }

    #tagline {
        font-size: 1em;
    }
</style>

<div id="video-intro-container">
    <video id="video-intro" src="/background.mp4" autoplay="true" muted="true" loop="true" />
</div>


<div class="absolute-top width-full flex flex-align-items-center flex-grow height-full text-align-center">
    <div id="above-fold" class="width-full text-align-center">
        <h1 id="site-title">
            {language.siteTitle}
        </h1>
        <h2 id="tagline">
            {language.tagline}
        </h2>
    </div>

</div>