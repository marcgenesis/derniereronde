---

import VideoBanner from "../VideoBanner/VideoBanner.astro";
import Welcome from "../Welcome/Welcome.astro";
import CollaborationsGallery from "../CollaborationsGallery/CollaborationsGallery.astro";
import WhyUs from "../WhyUs/WhyUs.astro";
import Quote from "../Quote/Quote.astro";
import VideoCarousel from "../VideoCarousel/VideoCarousel.astro";

import en from "./en.json"
import fr from "./fr.json"
const language = Astro.currentLocale == "fr" ? fr : en
---
<style>
    #action {
        font-family: "Cabin", sans-serif;
        font-size: 2em;
        flex-grow: 0;
        min-width: 40%;
        height: 100%;
        margin: 180px 0;
        text-align: center;
    }
</style>

<VideoBanner />
<Welcome />
<WhyUs />
<VideoCarousel />
<CollaborationsGallery />
<div id="action">
    {language.action}
</div>
<Quote />